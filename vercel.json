{
  "version": 2,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index-junta.html",
      "has": [{ "type": "host", "value": "junta-lexia.metrik.com.co" }]
    },
    { "source": "/demo", "destination": "/demo.html" },
    { "source": "/lexia/api/(.*)", "destination": "/api/$1" },
    { "source": "/lexia/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/lexia", "destination": "/index.html" },
    { "source": "/lexia/(.*)", "destination": "/$1" }
  ]
}
